        <img src="/img/dinero-head.svg" alt="southside/dinero" />
    </h1>

    <div class="dinero-hero-nav">
        <img class="dinero-hero-cart" src="/img/shopcart.png" alt="shopping cart" />
        <!-- Mobile-only trigger for the off-canvas radio queue (Queue.astro) -->
